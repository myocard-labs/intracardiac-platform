# --------------------------------------------------------------------
# Editor + OS
# --------------------------------------------------------------------
.DS_Store
*.swp
*.swo
.vscode/
.idea/

# --------------------------------------------------------------------
# Per-chat handoff prompts live at the workspace level (alongside the repos),
# not in git. Guard against accidental re-creation inside the repo.
# --------------------------------------------------------------------
project/prompts/

# --------------------------------------------------------------------
# LaTeX side products (in case anyone compiles a PDF from Documentation/)
# --------------------------------------------------------------------
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc

# --------------------------------------------------------------------
# Local-only design-doc build scripts may produce these
# --------------------------------------------------------------------
Documentation/*.tmp
Documentation/__pycache__/

# --------------------------------------------------------------------
# references/ holds third-party reference literature (PDFs) staged locally.
# The PDFs are NOT committed (large + third-party). The one tracked file is
# references/README.md — the paper index (title · why-it-applies · download
# link) that keeps the reading list in git without the PDFs.
# --------------------------------------------------------------------
references/*
!references/README.md
Papers/

# --------------------------------------------------------------------
# Python (in case someone runs examples/ or integration/ scripts locally)
# --------------------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.venv*/
venv/

# --------------------------------------------------------------------
# Generated artifacts + heavy binaries — never committed. Phase manifests
# point at banks/models that live in producer output dirs / GitHub Releases,
# so the heavy files stay out of git even when a phases/ manifest references
# them.
# --------------------------------------------------------------------
integration/output/
*.h5
*.pt
*.onnx
